# LAN IP of the Docker host; services publish their ports on it.
SERVER_IP=

# Doorbell camera (used by go2rtc.yaml)
CAMERA_IP=
CAMERA_USER=
CAMERA_PASS=

# MQTT passwords, one per account (frigate, gatekeeper, homeassistant).
# Generate each with e.g.: openssl rand -hex 16
MQTT_FRIGATE_PASSWORD=
MQTT_GATEKEEPER_PASSWORD=
MQTT_HOMEASSISTANT_PASSWORD=

# ntfy (doorbell notifications). Append these with:
#   scripts/ntfy-auth.sh 'password-for-the-phone-app' >> .env
NTFY_GATEKEEPER_TOKEN=
NTFY_GATEKEEPER_PASSWORD_HASH=
NTFY_PHONE_PASSWORD_HASH=

# Where recordings, MQTT data, visitor audio, logs and model caches live.
# An existing /docker/<service>/... install keeps its data with DATA_DIR=/docker.
DATA_DIR=./data

TZ=America/Chicago

# Optional services: "ha" adds a Home Assistant container (for testing).
# COMPOSE_PROFILES=ha

# Recognize the household by face (README, "Household faces"). Faces are biometric
# data: turn it on only with the household's agreement, and check your local law.
# FACE_RECOGNITION=1
# A password for the faces page on SERVER_IP:8098, where you enroll people. Without
# one, the page is off.
# GATEKEEPER_WEB_PASSWORD=

# NVIDIA GPU (README, "GPU (NVIDIA)"): Frigate's detection and Whisper on the GPU.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# The hub's own name, <id>.gatekeeperhome.net, with a Let's Encrypt certificate the phone
# trusts (README, "Hub name"). It needs WEB_TLS=1 and a claim code from Gatekeeper, and is
# served on port 443 (with the GPU too: ...:docker-compose.gpu.yml:docker-compose.hubname.yml).
# HUB_NAME_CLAIM=
# COMPOSE_FILE=docker-compose.yml:docker-compose.hubname.yml

# The conversation model in shadow (README, "Conversation model (shadow)"): asked after
# each visit what it would have said. Its .gguf file goes in
# ${DATA_DIR}/gatekeeper/conversation-model. With Home Assistant too:
# COMPOSE_PROFILES=ha,conversation-model
# COMPOSE_PROFILES=conversation-model
# CONVERSATION_MODEL=shadow
# CONVERSATION_MODEL_FILE=
# Its vision file, in the same folder (for Gemma 4, the base model's mmproj): it's then
# also asked what it sees in each visit's picture.
# CONVERSATION_MODEL_MMPROJ=

# Rig tooling (README, "Running a rig"): publish the daily reports to a PRIVATE GitHub
# repository (its SSH URL) with a deploy key, and the branch that deploy.sh follows.
# RIG_REPORTS_REPO=git@github.com:you/gatekeeper-reports.git
# RIG_REPORTS_KEY=/home/you/.ssh/gatekeeper-reports
# DEPLOY_BRANCH=main

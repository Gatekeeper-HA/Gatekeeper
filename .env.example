# LAN IP of the Docker host; services publish their ports on it.
SERVER_IP=

# Doorbell camera (used by go2rtc.yaml)
CAMERA_IP=
CAMERA_USER=
CAMERA_PASS=

# MQTT passwords, one per account (frigate, gatekeeper, homeassistant).
# Generate each with e.g.: openssl rand -hex 16
MQTT_FRIGATE_PASSWORD=
MQTT_GATEKEEPER_PASSWORD=
MQTT_HOMEASSISTANT_PASSWORD=

# Where recordings, MQTT data, visitor audio, logs and model caches live.
# An existing /docker/<service>/... install keeps its data with DATA_DIR=/docker.
DATA_DIR=./data

TZ=America/Chicago

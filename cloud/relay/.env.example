# The relay's settings (cloud/README.md, "The relay"). Copy to .env, mode 600.

# The zone of hub names (TURN's realm).
ZONE=
# This server's public addresses: coturn listens and relays on them, and never to them.
RELAY_IPV4=
RELAY_IPV6=
# The same two values as in the name service's .env, on its server.
RELAY_FERNET_KEYS=
TURN_SECRET=

# The name service's settings (cloud/README.md, "Deploying"). Copy to .env, mode 600.

# The zone of hub names.
ZONE=
# This server's public addresses: the zone's nameservers and the API.
SERVER_IPV4=
SERVER_IPV6=
# PowerDNS's API key, shared with hubnames only: openssl rand -hex 32
PDNS_API_KEY=

# The relay, on its own server (cloud/README.md, "The relay"). Leave these empty for none.
# Its public addresses, for relay.<zone>:
RELAY_IPV4=
RELAY_IPV6=
# The Fernet key shared with the relay, which reads the passes made with it:
#   python3 -c 'import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
# A new key goes first, the old one after it, until the old passes have run out (an hour).
RELAY_FERNET_KEYS=
# coturn's secret, shared with the relay: openssl rand -hex 32
TURN_SECRET=
